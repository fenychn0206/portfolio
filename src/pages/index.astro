---
import App from "$layouts/App.astro";

const projects = [
	{
		name: "lps-community-guide",
		description: "A wiki by Minecraft Transit Railway mod Let's Play Server China community.",
		href: "https://github.com/mtrlps-community/lps-community-guide"
	}
];

const posts = [
	{
		title: "使用 GitHub Action 备份 Artalk 数据至仓库",
		href: "https://www.ooowl.net/posts/back-up-artalk-data-using-github/"
	},
	{ title: "从 Visual Studio Code 到 Zed", href: "https://www.ooowl.net/posts/vscode-to-zed/" },
	{
		title: "为 UptimeFlare 设置飞书通知",
		href: "https://www.ooowl.net/posts/setup-lark-notification-for-uptimeflare/"
	},
	{ title: "我在用什么：2026", href: "https://www.ooowl.net/posts/what-im-using-2026/" },
	{ title: "它很适合我 —— Mole 使用体验", href: "https://www.ooowl.net/posts/mole/" }
];
---

<App>
	<main
		class="mx-auto w-full max-w-[1040px] px-6 pt-10 pb-16 lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16 lg:py-14"
	>
		<aside class="flex flex-col items-start gap-3 lg:sticky lg:top-24 lg:self-start">
			<img
				src="/favicon.jpg"
				alt="Avatar"
				width="128"
				height="128"
				class="mb-2 size-32 rounded-full object-cover"
			/>
			<h1 class="font-header text-[1.75rem] leading-tight font-bold">Frederick Chen</h1>
			<p class="text-sm opacity-60">@fenychn0206</p>
			<p class="mt-1 text-sm font-bold">Student / ex-OIer / Blogger / Developer / Rail Lover</p>

			<ul class="mt-2 flex flex-col gap-1.5 text-sm">
				<li class="flex items-center gap-2">
					<i class="iconify mdi--clock-outline" aria-hidden="true"></i>
					<span>UTC+08:00</span>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--email-outline" aria-hidden="true"></i>
					<a href="mailto:hey@ohdragonboi.cn">hey@ohdragonboi.cn</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--translate" aria-hidden="true"></i>
					<span>简体中文 / English</span>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--github" aria-hidden="true"></i>
					<a href="https://github.com/fenychn0206" target="_blank" rel="noreferrer">GitHub</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--post-outline" aria-hidden="true"></i>
					<a href="https://www.ooowl.net/" target="_blank" rel="noreferrer">ooowl.net</a>
				</li>
			</ul>
		</aside>

		<div class="mt-12 min-w-0 lg:mt-0">
			<nav class="flex flex-wrap gap-x-6 gap-y-2 border-b border-primary/20 text-sm font-bold">
				<a class="not-underline-hover -mb-px border-b-2 border-primary pb-2.5" href="#about">About</a>
				<a
					class="not-underline-hover -mb-px border-b-2 border-transparent pb-2.5 hover:border-primary/40"
					href="#projects">Projects</a
				>
				<a
					class="not-underline-hover -mb-px border-b-2 border-transparent pb-2.5 hover:border-primary/40"
					href="#writing">Writing</a
				>
				<a
					class="not-underline-hover -mb-px border-b-2 border-transparent pb-2.5 hover:border-primary/40"
					href="#sponsor">Sponsor</a
				>
			</nav>

			<section id="about" class="content scroll-mt-24 pt-8">
				<h2>About Me</h2>
				<p>
					Hi, I'm <strong>Frederick Chen</strong>, known online as <strong>fenychn0206</strong>. 这里是我的 GitHub
					Pages 主页，日常写代码、写博客，也折腾轨道交通。
				</p>
				<p class="callout">
					Student / ex-OIer / Blogger / Developer / Rail Lover
				</p>
			</section>

			<section id="projects" class="content scroll-mt-24 pt-10">
				<h2>Projects</h2>
				<div class="grid gap-4 pt-2 sm:grid-cols-2">
					{
						projects.map((project) => (
							<a
								href={project.href}
								target="_blank"
								rel="noreferrer"
								class="not-underline-hover flex flex-col gap-1 rounded-xl border border-primary/25 p-5 duration-300 ease-in-out hover:bg-primary/5"
							>
								<strong class="text-base font-bold">{project.name}</strong>
								<span class="text-sm opacity-70">{project.description}</span>
							</a>
						))
					}
				</div>
			</section>

			<section id="writing" class="content scroll-mt-24 pt-10">
				<h2>Writing</h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={post.href} target="_blank" rel="noreferrer">
									{post.title}
								</a>
							</li>
						))
					}
				</ul>
				<p class="mt-4 text-sm">
					<a href="https://www.ooowl.net/" target="_blank" rel="noreferrer">阅读更多…… / Read More…</a>
				</p>
			</section>

			<section id="sponsor" class="content scroll-mt-24 pt-10">
				<h2>Sponsor Me</h2>
				<p>
					你的赞助对我非常重要，它可以帮助我维护我的项目和服务。如果我的项目对你有帮助，为什么不考虑赞助一下！
				</p>
				<p class="mt-4">
					<a href="https://afdian.com/a/fenychn0206" target="_blank" rel="noreferrer">爱发电 / Afdian</a>
				</p>
			</section>

			<footer class="mt-16 border-t border-primary/20 pt-6 text-xs opacity-60">
				© 2019 - {new Date().getFullYear()} Frederick Chen. All rights reserved.
			</footer>
		</div>
	</main>
</App>
