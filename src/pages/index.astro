---
import { getEntry, render } from "astro:content";
import App from "$layouts/App.astro";

const about = await getEntry("about", "about");
if (!about) {
	throw new Error("Missing content entry: src/content/about.md");
}
const { Content } = await render(about);
---

<App>
	<main class="mx-auto w-full max-w-[900px] px-6 pt-10 pb-16 lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16 lg:py-14">
		<aside class="flex flex-col items-start gap-3 text-sm lg:sticky lg:top-24 lg:self-start lg:text-base">
			<picture>
				<source srcset="/avatar-dark.jpeg" media="(prefers-color-scheme: dark)" />
				<img src="/avatar.jpeg" alt="Avatar" width="128" height="128" class="mb-2 size-32 rounded-full object-cover" />
			</picture>
			<h1 class="font-header text-[1.75rem] leading-tight font-bold">Frederick Chen</h1>
			<p>@fenychn0206</p>
			<p class="mt-1 font-bold">Student / ex-OIer / Blogger / Developer / Metropolitan Transport Enthusiasts</p>

			<ul class="mt-2 flex flex-col gap-1.5">
				<li class="flex items-center gap-2">
					<i class="iconify mdi--clock-outline" aria-hidden="true"></i>
					<span>UTC+08:00</span>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--email-outline" aria-hidden="true"></i>
					<a href="mailto:me@ooowl.net">me@ooowl.net</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--translate" aria-hidden="true"></i>
					<span>简体中文 / English</span>
				</li>
			</ul>

			<ul class="mt-3 flex flex-row items-center gap-1">
				<li>
					<a class="not-underline-hover inline-flex" href="https://github.com/fenychn0206" target="_blank" rel="noreferrer" title="GitHub" aria-label="GitHub">
						<i class="iconify mdi--github size-6" aria-hidden="true"></i>
					</a>
				</li>
				<li>
					<a class="not-underline-hover inline-flex" href="https://x.com/@fenychn0206" target="_blank" rel="noreferrer" title="X" aria-label="X">
						<i class="iconify mdi--twitter size-6" aria-hidden="true"></i>
					</a>
				</li>
				<li>
					<a class="not-underline-hover inline-flex" href="https://www.travellings.cn/go.html" target="_blank" rel="noreferrer" title="开往 / Travellings" aria-label="开往 / Travellings">
						<i class="iconify mdi--train size-6" aria-hidden="true"></i>
					</a>
				</li>
			</ul>
		</aside>

		<div class="mt-12 min-w-0 lg:mt-0">
			<nav class="flex flex-wrap gap-x-6 gap-y-2 border-b border-primary/20 text-sm font-bold">
				<a class="not-underline-hover -mb-px border-b-2 border-primary pb-2.5" href="/" aria-current="page">About</a>
				<a class="not-underline-hover -mb-px border-b-2 border-transparent pb-2.5 hover:border-primary/40" href="https://www.ooowl.net/">Blog</a>
			</nav>

			<article class="prose">
				<Content />
			</article>
		</div>
	</main>
</App>
