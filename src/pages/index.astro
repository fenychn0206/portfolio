---
import App from "$layouts/App.astro";

const projects = [
	{
		name: "lps-community-guide",
		description: "A wiki by Minecraft Transit Railway mod Let's Play Server China community.",
		href: "https://github.com/mtrlps-community/lps-community-guide"
	}
];

const posts = [
	{
		title: "使用 GitHub Action 备份 Artalk 数据至仓库",
		href: "https://www.ooowl.net/posts/back-up-artalk-data-using-github/"
	},
	{ title: "从 Visual Studio Code 到 Zed", href: "https://www.ooowl.net/posts/vscode-to-zed/" },
	{
		title: "为 UptimeFlare 设置飞书通知",
		href: "https://www.ooowl.net/posts/setup-lark-notification-for-uptimeflare/"
	},
	{ title: "我在用什么：2026", href: "https://www.ooowl.net/posts/what-im-using-2026/" },
	{ title: "它很适合我 —— Mole 使用体验", href: "https://www.ooowl.net/posts/mole/" }
];
---

<App>
	<div class="flex items-center justify-center min-h-[90vh] px-4 py-20">
		<div class="flex max-sm:flex-col sm:items-center gap-20 sm:gap-28 max-w-4xl w-full">
			<div class="flex flex-col items-center shrink-0">
				<span class="w-42 h-42 rounded-full overflow-hidden">
					<img src="/favicon.jpg" alt="Avatar" draggable="false" class="inline-block w-full h-full rounded-full object-cover" />
				</span>

				<strong class="mt-9 font-header text-2xl font-bold tracking-widest select-text">fenychn0206</strong>

				<div class="flex gap-8 mt-5 text-2xl">
					<a href="https://github.com/fenychn0206" target="_blank" aria-label="GitHub" title="Browse projects" class="not-underline-hover inline-flex"><i class="iconify mdi--github"></i></a>
					<a href={`mailto:hey@ohdragonboi.cn`} aria-label="Email" title="Get in touch" class="not-underline-hover inline-flex"><i class="iconify mdi--email-outline"></i></a>
					<a href="https://blog.ohdragonboi.cn" target="_blank" aria-label="Blog" title="Explore thoughts" class="not-underline-hover inline-flex"><i class="iconify mdi--post-outline"></i></a>
				</div>
			</div>

			<article class="content flex flex-col gap-9 mb-10 select-text">
				<p>Hi, I'm <strong>Frederick Chen</strong>, known online as <strong>fenychn0206</strong>.</p>

				<blockquote>Student / ex-OIer / Blogger / Developer / Rail Lover</blockquote>

				<section>
					<h2>Projects I've Worked On</h2>
					<ul>
						{projects.map((project) => (
							<li>
								<a href={project.href} target="_blank" rel="noreferrer">{project.name}</a>
								<span class="text-secondary"> — {project.description}</span>
							</li>
						))}
					</ul>
				</section>

				<section>
					<h2>Writing</h2>
					<ul>
						{posts.map((post) => (
							<li>
								<a href={post.href} target="_blank" rel="noreferrer">{post.title}</a>
							</li>
						))}
					</ul>
					<p class="mt-3 text-sm">
						<a href="https://blog.ohdragonboi.cn" target="_blank" rel="noreferrer">Read More…</a>
					</p>
				</section>

				<section>
					<h2>Sponsor Me</h2>
					<p class="text-secondary">If my projects helped you, why not to buy a coffee to me?</p>
					<p class="mt-3">
						<a href="https://afdian.com/a/fenychn0206" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1">
							<i class="iconify mdi--heart-outline"></i>
							<span>Afdian</span>
						</a>
					</p>
				</section>
			</article>
		</div>
	</div>
</App>
