---
import { ClientRouter } from "astro:transitions";
import "$styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Frederick Chen (@fenychn0206)",
	description = "Student / ex-OIer / Blogger / Developer / Metropolitan Transport Enthusiasts"
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<meta name="color-scheme" content="light dark" />

		<!--
			Two icon sets, one per colour scheme: a dark glyph on light paper and
			a white one on dark paper. Chromium and Firefox honour the media
			attribute on icon links, so the tab picks the right file while the
			page is parsed, without waiting for JavaScript. WebKit ignores it,
			so the script below also points every icon at the matching scheme.
		-->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" data-icon-light="/favicon.svg" data-icon-dark="/favicon-white.svg" />
		<link rel="icon" type="image/svg+xml" href="/favicon-white.svg" media="(prefers-color-scheme: dark)" data-icon-light="/favicon.svg" data-icon-dark="/favicon-white.svg" />
		<link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" media="(prefers-color-scheme: light)" data-icon-light="/favicon.ico" data-icon-dark="/favicon-white.ico" />
		<link rel="icon" type="image/x-icon" sizes="any" href="/favicon-white.ico" media="(prefers-color-scheme: dark)" data-icon-light="/favicon.ico" data-icon-dark="/favicon-white.ico" />

		<script is:inline>
			// Fallback for browsers that ignore the media attribute on icon
			// links. Runs before first paint so the tab never flashes the wrong
			// colour, and again after every page transition replaces the head.
			(() => {
				const query = window.matchMedia("(prefers-color-scheme: dark)");
				const apply = isDark => {
					document.querySelectorAll('link[rel~="icon"][data-icon-light]').forEach(link => {
						link.setAttribute("href", isDark ? link.dataset.iconDark : link.dataset.iconLight);
					});
				};
				apply(query.matches);
				query.addEventListener("change", event => apply(event.matches));
				document.addEventListener("astro:after-swap", () => apply(query.matches));
			})();
		</script>

		<ClientRouter />

		<title>{title}</title>
	</head>
<body class="lg:h-screen lg:overflow-hidden">
		<slot />
	</body>
</html>
