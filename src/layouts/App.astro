---
import "$styles/global.css";

const title = "fenychn0206";
const description = "Student / ex-OIer / Blogger / Developer / Rail Lover";
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<meta name="color-scheme" content="light dark" />

		<link
			rel="icon"
			type="image/svg+xml"
			href="/favicon.svg"
			data-icon-light="/favicon.svg"
			data-icon-dark="/favicon-white.svg"
		/>
		<link
			rel="icon"
			type="image/x-icon"
			sizes="any"
			href="/favicon.ico"
			data-icon-light="/favicon.ico"
			data-icon-dark="/favicon-white.ico"
		/>

		<script is:inline>
			// The icon pair follows the blog: a dark glyph on light paper, a white
			// one on dark paper. Swapping happens before first paint so the tab
			// never flashes the wrong colour.
			;(() => {
				const query = window.matchMedia('(prefers-color-scheme: dark)')
				const apply = (isDark) => {
					document.querySelectorAll('link[rel~="icon"][data-icon-light]').forEach((link) => {
						link.setAttribute('href', isDark ? link.dataset.iconDark : link.dataset.iconLight)
					})
				}
				apply(query.matches)
				query.addEventListener('change', (event) => apply(event.matches))
			})()
		</script>

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
