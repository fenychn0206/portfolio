---
import App from "$layouts/App.astro";

interface Props {
	/** Key of the nav item that should be marked as the current page. */
	active: "about" | "projects";
	title?: string;
}

const { active, title } = Astro.props;

interface NavItem {
	key: "about" | "projects" | "blog";
	label: string;
	href: string;
	/** Opens in a new tab. */
	external?: boolean;
}

const navItems: NavItem[] = [
	{ key: "about", label: "About", href: "/" },
	{ key: "projects", label: "Projects", href: "/projects" },
	{ key: "blog", label: "Blog", href: "https://www.ooowl.net/", external: true }
];
---

<App title={title}>
	<main class="mx-auto w-full max-w-[900px] px-6 pt-10 pb-16 lg:grid lg:h-full lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16 lg:py-0">
		<aside class="flex flex-col items-start gap-3 text-base lg:max-h-full lg:self-start lg:overflow-y-auto lg:pt-14">
			<picture>
				<source srcset="/avatar-dark.jpeg" media="(prefers-color-scheme: dark)" />
				<img src="/avatar.jpeg" alt="Avatar" width="128" height="128" class="mb-2 size-32 rounded-full object-cover" />
			</picture>
			<h1 class="font-header text-[1.75rem] leading-tight font-bold">Frederick Chen</h1>
			<p>@fenychn0206 · dragon</p>
			<p class="mt-1 font-bold">Student / ex-OIer / Blogger / Developer / Metropolitan Transport Enthusiasts</p>

			<ul class="mt-2 flex flex-col gap-1.5">
				<li class="flex items-center gap-2">
					<i class="iconify mdi--clock-outline" aria-hidden="true"></i>
					<span>UTC+08:00</span>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--email-outline" aria-hidden="true"></i>
					<a href="mailto:me@ooowl.net">me@ooowl.net</a>
				</li>
				<li class="flex items-center gap-2">
					<i class="iconify mdi--translate" aria-hidden="true"></i>
					<span>简体中文 / English</span>
				</li>
			</ul>

			<ul class="mt-3 flex flex-row items-center gap-1">
				<li>
					<a class="not-underline-hover inline-flex" href="https://github.com/fenychn0206" target="_blank" rel="noreferrer" title="GitHub" aria-label="GitHub">
						<i class="iconify mdi--github size-6" aria-hidden="true"></i>
					</a>
				</li>
				<li>
					<a class="not-underline-hover inline-flex" href="https://x.com/@fenychn0206" target="_blank" rel="noreferrer" title="X" aria-label="X">
						<i class="iconify mdi--twitter size-6" aria-hidden="true"></i>
					</a>
				</li>
				<li>
					<a class="not-underline-hover inline-flex" href="https://www.travellings.cn/go.html" target="_blank" rel="noreferrer" title="开往 / Travellings" aria-label="开往 / Travellings">
						<i class="iconify mdi--train size-6" aria-hidden="true"></i>
					</a>
				</li>
			</ul>
		</aside>

		<div class="mt-12 min-w-0 lg:mt-0 lg:flex lg:h-full lg:min-h-0 lg:flex-col">
			<nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold lg:pt-10 lg:text-base">
				{
					navItems.map(item => (
						<a class:list={["not-underline-hover border-b-2 pb-2.5", active === item.key ? "border-primary" : "border-transparent hover:border-primary/40"]} href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined} aria-current={active === item.key ? "page" : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>

			<div class="lg:min-h-0 lg:flex-1 lg:overflow-y-scroll lg:overscroll-contain scrollbar-hide">
				<slot />

				<hr class="mt-7.5 mb-5 border-primary/20" />

				<footer class="pb-8 text-xs leading-[1.5] font-bold">
					<p>
						© {new Date().getFullYear()} Frederick Chen. Powered by
						<a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>.
					</p>
				</footer>
			</div>
		</div>
	</main>
</App>
