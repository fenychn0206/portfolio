---
import { appearance } from "../config";

const defaultTheme = appearance.theme;
---

<script is:inline define:vars={{ defaultTheme }}>
	// Preference is stored locally so it survives reloads. `system` follows the
	// OS, while `light` and `dark` force a mode. Swapping the `dark` class on
	// <html> is what flips every colour token.
	const THEME_STORAGE_KEY = 'theme-preference'
	const THEME_PREFERENCES = ['system', 'light', 'dark']
	const THEME_LABELS = { system: 'System', light: 'Light', dark: 'Dark' }

	function getThemePreference() {
		// The applied preference is authoritative for this document session; it
		// also lets the toggle keep working when storage is blocked.
		const applied = document.documentElement.dataset.themePreference
		if (THEME_PREFERENCES.includes(applied)) {
			return applied
		}

		try {
			const stored = window.localStorage.getItem(THEME_STORAGE_KEY)
			if (THEME_PREFERENCES.includes(stored)) {
				return stored
			}
		} catch {
			// Storage may be unavailable (private mode); fall back to the default.
		}

		return defaultTheme
	}

	function syncThemeToggle(preference) {
		const label = `Theme: ${THEME_LABELS[preference]} (Click to toggle)`
		document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
			button.setAttribute('title', label)
			button.setAttribute('aria-label', label)
		})
	}

	function updateTheme() {
		const preference = getThemePreference()
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
		const dark = preference === 'dark' || (preference === 'system' && prefersDark)

		document.documentElement.classList.toggle('dark', dark)
		document.documentElement.dataset.themePreference = preference
		syncThemeToggle(preference)
	}

	function setThemePreference(preference) {
		// Apply the choice before saving, so it sticks even when storage is blocked.
		document.documentElement.dataset.themePreference = preference

		try {
			window.localStorage.setItem(THEME_STORAGE_KEY, preference)
		} catch {
			// Keep the in-page theme working even when persistence is blocked.
		}

		updateTheme()
	}

	// Order: system -> light -> dark -> system.
	function cycleTheme() {
		const preference = getThemePreference()
		const next = THEME_PREFERENCES[(THEME_PREFERENCES.indexOf(preference) + 1) % THEME_PREFERENCES.length]
		setThemePreference(next)
	}

	updateTheme()

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', updateTheme, { once: true })
	}

	if (!document.documentElement.dataset.themeListenersReady) {
		document.documentElement.dataset.themeListenersReady = 'true'

		document.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('[data-theme-toggle]')) {
				cycleTheme()
			}
		})

		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
			if (getThemePreference() === 'system') {
				updateTheme()
			}
		})
	}
</script>
