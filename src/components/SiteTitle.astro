---
import { site } from "../config";

const { title, subtitle } = site;
---

<hgroup
	class="flex flex-col gap-2.5 cursor-pointer text-center duration-800 ease-in-out lg:[writing-mode:vertical-rl] lg:items-start lg:border-l-2 lg:border-l-primary lg:text-left"
>
	<a
		class="not-underline-hover duration-800 ease-in-out lg:pl-2.5 lg:pr-2.5 lg:pb-12 lg:hover:pt-3.75 lg:hover:pb-8.75 lg:hover:bg-primary lg:hover:text-background"
		href={site.website}
	>
		<h3 class="text-xl leading-[1.5] font-extrabold font-header">{subtitle}</h3>
		<h1 class="text-[2rem] font-extrabold font-header">{title}</h1>
	</a>
</hgroup>
