---
import { appearance } from "../config";

const { theme } = appearance;

const preferences = [
	{ preference: "system", icon: "i-[mdi--theme-light-dark]", label: "System" },
	{ preference: "light", icon: "i-[mdi--white-balance-sunny]", label: "Light" },
	{ preference: "dark", icon: "i-[mdi--weather-night]", label: "Dark" }
] as const;

const current = preferences.find(({ preference }) => preference === theme) ?? preferences[0];
const label = `Theme: ${current.label} (Click to toggle)`;
---

<button
	type="button"
	class="theme-toggle inline-flex size-6 cursor-pointer items-center justify-center rounded transition-opacity duration-200"
	data-theme-toggle
	aria-label={label}
	title={label}
>
	{
		preferences.map(({ preference, icon }) => (
			<span
				class:list={[icon, "theme-toggle-icon size-6", `theme-toggle-icon-${preference}`]}
				aria-hidden="true"
			/>
		))
	}
</button>

<style>
	.theme-toggle-icon {
		display: none;
	}

	/* Fallback when scripts are blocked: show the system icon. */
	.theme-toggle-icon-system {
		display: block;
	}

	html[data-theme-preference='light'] .theme-toggle-icon-system,
	html[data-theme-preference='dark'] .theme-toggle-icon-system {
		display: none;
	}

	html[data-theme-preference='light'] .theme-toggle-icon-light,
	html[data-theme-preference='dark'] .theme-toggle-icon-dark {
		display: block;
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}
</style>
